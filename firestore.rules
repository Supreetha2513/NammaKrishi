rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Allow authenticated users to read equipment
    match /equipment/{document=**} {
      allow read: if request.auth.uid != null;
      allow write: if false; // Only admin can write
    }
    
    // Allow users to create and read their own bookings
    match /bookings/{bookingId} {
      allow create: if request.auth.uid != null;
      allow read, write: if request.auth.uid == resource.data.customer_id;
    }
    
    // Allow users to create and read their own equipment requests
    match /equipment_requests/{requestId} {
      allow create: if request.auth.uid != null;
      allow read, write: if request.auth.uid == resource.data.customer_id;
    }
    
    // Allow users to read their own payments
    match /payments/{paymentId} {
      allow read, write: if request.auth.uid != null;
    }
  }
}
